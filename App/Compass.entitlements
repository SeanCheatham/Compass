<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTD/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>com.apple.security.virtualization</key>
	<true/>
	<key>com.apple.security.network.client</key>
	<true/>
	<!--
	Enables the data protection keychain on macOS, scoping items by
	`<team>.<bundle>` instead of cdhash. Required by
	SharedCompassVMGuestCredential, which keeps the guest SSH key in
	the keychain so re-signing the dev build doesn't re-prompt for
	access on every rebuild.
	-->
	<key>keychain-access-groups</key>
	<array>
		<string>$(AppIdentifierPrefix)$(CFBundleIdentifier)</string>
	</array>
</dict>
</plist>
