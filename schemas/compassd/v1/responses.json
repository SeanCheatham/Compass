{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://compass.local/schemas/compassd/v1/responses.json",
  "title": "Compass daemon response envelope",
  "type": "object",
  "required": ["schema_version", "id", "ok", "errors"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "id": {
      "type": "string"
    },
    "ok": {
      "type": "boolean"
    },
    "result": true,
    "errors": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
