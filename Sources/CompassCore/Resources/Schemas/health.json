{
  "type": "object",
  "additionalProperties": false,
  "required": ["plan", "generatedTests", "findings", "notes"],
  "properties": {
    "plan": {
      "type": "string",
      "description": "Short plan: what you probed or cleaned and why."
    },
    "focus": {
      "type": "string",
      "enum": ["bugHunt", "test", "cleanup", "docs"]
    },
    "generatedTests": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "compiled"],
        "properties": {
          "path": { "type": "string" },
          "targetHint": { "type": "string" },
          "compiled": { "type": "boolean" },
          "passed": { "type": ["boolean", "null"] },
          "compileErrors": { "type": ["string", "null"] }
        }
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "title", "description"],
        "properties": {
          "id": { "type": "string" },
          "kind": {
            "type": "string",
            "enum": [
              "failingGeneratedTest",
              "baselineFailure",
              "survivingMutant",
              "staleDoc",
              "orphanedSurface",
              "testGap",
              "deadCode"
            ]
          },
          "title": { "type": "string" },
          "description": { "type": "string" },
          "file": { "type": ["string", "null"] },
          "testPath": { "type": ["string", "null"] },
          "confidence": { "type": "number" },
          "triage": {
            "type": ["object", "null"],
            "additionalProperties": false,
            "required": ["isRealBug", "rationale"],
            "properties": {
              "isRealBug": { "type": "boolean" },
              "rationale": { "type": "string" }
            }
          },
          "evidence": { "type": "string" },
          "commitSHA": { "type": ["string", "null"] },
          "focus": {
            "type": "string",
            "enum": ["bugHunt", "test", "cleanup", "docs"]
          }
        }
      }
    },
    "notes": {
      "type": "array",
      "items": { "type": "string" }
    }
  }
}
