{
  "type": "object",
  "additionalProperties": false,
  "required": ["state", "summary", "lessonEdits"],
  "properties": {
    "state": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["immediate", "candidates", "strategicContext", "openQuestions"],
          "properties": {
            "immediate": { "$ref": "#/$defs/immediate" },
            "candidates": {
              "type": "array",
              "maxItems": 6,
              "items": { "$ref": "#/$defs/candidate" }
            },
            "strategicContext": { "$ref": "#/$defs/strategicContext" },
            "openQuestions": {
              "type": "array",
              "maxItems": 4,
              "items": { "$ref": "#/$defs/openQuestion" }
            }
          }
        },
        { "type": "null" }
      ]
    },
    "summary": { "type": "string" },
    "lessonEdits": {
      "type": "array",
      "items": { "$ref": "#/$defs/lessonEdit" }
    },
    "tournamentDecisionUpdates": {
      "type": "array",
      "maxItems": 4,
      "description": "Tournament experiment decision updates justified by Product Tournament evidence. Use [] when no experiment decision should change.",
      "items": { "$ref": "#/$defs/tournamentDecisionUpdate" }
    },
    "pmfProofOutcome": {
      "anyOf": [
        { "$ref": "#/$defs/pmfProofOutcome" },
        { "type": "null" }
      ],
      "description": "Optional PMF proof outcome metadata for the proof action just completed or reviewed."
    }
  },
  "$defs": {
    "pmfProofOutcome": {
      "type": "object",
      "additionalProperties": false,
      "required": ["actionKind", "signal", "proofDebtDelta", "tokenCostWasWorthIt"],
      "properties": {
        "actionKind": { "$ref": "#/$defs/pmfProofActionKind" },
        "signal": {
          "type": "string",
          "description": "Concise summary of the evidence signal produced by the proof action."
        },
        "proofDebtDelta": {
          "type": "string",
          "description": "How proof debt moved: cleared, reduced, unchanged, worsened, or unknown."
        },
        "tokenCostWasWorthIt": {
          "anyOf": [
            { "type": "boolean" },
            { "type": "null" }
          ],
          "description": "Whether the token spend was worth the signal gained."
        }
      }
    },
    "pmfProofActionKind": {
      "type": "string",
      "enum": [
        "sharpen_hypothesis",
        "run_plan_proof",
        "run_buyer_proof",
        "build_feasibility_slice",
        "run_switching_proof",
        "run_use_proof",
        "revise_product",
        "stop_no_useful_proof"
      ]
    },
    "immediate": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "plan",
            "verify",
            "verifyTimeoutMs",
            "estimatedDifficulty",
            "selectedBecause",
            "source",
            "candidateID"
          ],
          "properties": {
            "plan": { "type": "string" },
            "verify": { "type": "string" },
            "verifyTimeoutMs": {
              "anyOf": [
                { "type": "integer", "minimum": 1 },
                { "type": "null" }
              ]
            },
            "estimatedDifficulty": {
              "anyOf": [
                { "type": "string", "enum": ["low", "medium", "high"] },
                { "type": "null" }
              ]
            },
            "selectedBecause": { "type": "string" },
            "source": {
              "type": "string",
              "enum": ["draft", "feedback", "candidate", "focus", "repository", "repair"]
            },
            "candidateID": {
              "anyOf": [
                { "type": "string" },
                { "type": "null" }
              ]
            }
          }
        },
        { "type": "null" }
      ]
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "outcome",
        "why",
        "category",
        "origin",
        "priority",
        "status",
        "evidence",
        "blockedBy",
        "risk"
      ],
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "outcome": { "type": "string" },
        "why": { "type": "string" },
        "category": {
          "type": "string",
          "enum": ["feature", "test", "cleanup", "docs", "bugHunt", "reliability", "exploration"]
        },
        "origin": {
          "type": "string",
          "enum": ["draft", "feedback", "repository", "plan", "reflect", "lesson", "user"]
        },
        "priority": { "type": "string", "enum": ["low", "medium", "high"] },
        "status": {
          "type": "string",
          "enum": ["available", "active", "blocked", "deferred", "done", "stale"]
        },
        "evidence": { "type": "array", "items": { "type": "string" }, "maxItems": 3 },
        "blockedBy": { "type": "array", "items": { "type": "string" }, "maxItems": 2 },
        "risk": {
          "anyOf": [
            { "type": "string" },
            { "type": "null" }
          ]
        }
      }
    },
    "strategicContext": {
      "type": "object",
      "additionalProperties": false,
      "required": ["thesis", "principles", "constraints", "nonGoals", "risks"],
      "properties": {
        "thesis": { "type": "string" },
        "principles": { "type": "array", "items": { "type": "string" }, "maxItems": 5 },
        "constraints": { "type": "array", "items": { "type": "string" }, "maxItems": 5 },
        "nonGoals": { "type": "array", "items": { "type": "string" }, "maxItems": 5 },
        "risks": { "type": "array", "items": { "type": "string" }, "maxItems": 5 }
      }
    },
    "openQuestion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "question", "impact"],
      "properties": {
        "id": { "type": "string" },
        "question": { "type": "string" },
        "impact": { "type": "string" }
      }
    },
    "lessonEdit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["find", "replace", "replaceAll"],
      "properties": {
        "find": { "type": "string" },
        "replace": { "type": "string" },
        "replaceAll": {
          "anyOf": [
            { "type": "boolean" },
            { "type": "null" }
          ]
        }
      }
    },
    "tournamentDecisionUpdate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["experimentID", "decision", "summary", "evidenceRunIDs", "decidedBy"],
      "properties": {
        "experimentID": {
          "type": "string",
          "description": "Exact tournament experiment id from Product Tournament Context."
        },
        "decision": {
          "type": "string",
          "enum": ["not_run", "continue", "narrow", "pivot", "kill", "promote", "archived", "promoted"],
          "description": "Next experiment decision following the allowed transition table."
        },
        "summary": {
          "type": "string",
          "description": "Evidence-grounded decision summary. Required to be non-empty for kill, promote, archived, and promoted."
        },
        "evidenceRunIDs": {
          "type": "array",
          "items": { "type": "string" },
          "maxItems": 8
        },
        "decidedBy": {
          "type": "string",
          "description": "Decision source, normally Reflect."
        }
      }
    }
  }
}
