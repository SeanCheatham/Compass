{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "summary",
    "stateEdits",
    "candidateTournamentExperiments",
    "openQuestions",
    "lessonEdits",
    "assumptions"
  ],
  "properties": {
    "summary": {
      "type": "string",
      "description": "Concise explanation of the discovered pain model and product contenders."
    },
    "stateEdits": {
      "$ref": "#/$defs/stateEdits",
      "description": "Structured Product Tournament state edits that seed pain hypotheses, contenders, tournament rounds, and implementation tracks."
    },
    "candidateTournamentExperiments": {
      "type": "array",
      "description": "Implementation tracks for Product Tournament contenders after the plan-only round; Compass materializes each candidate into a durable tournament experiment and starter scenario when the contender is not already linked to one and the target segment/workflow can be resolved.",
      "maxItems": 6,
      "items": { "$ref": "#/$defs/candidateTournamentExperiment" }
    },
    "openQuestions": {
      "type": "array",
      "maxItems": 8,
      "items": { "type": "string", "maxLength": 240 }
    },
    "lessonEdits": {
      "type": "array",
      "maxItems": 4,
      "items": { "$ref": "#/$defs/lessonEdit" }
    },
    "assumptions": {
      "type": "array",
      "maxItems": 8,
      "items": { "$ref": "#/$defs/assumption" }
    }
  },
  "$defs": {
    "stateEdits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rawPain",
        "painHypotheses",
        "userSegments",
        "currentWorkflows",
        "alternatives",
        "markets",
        "contenderPlans",
        "tournamentExperiments",
        "tournaments",
        "tournamentContenders",
        "tournamentRounds",
        "scenarioCohorts",
        "decisions"
      ],
      "properties": {
        "rawPain": {
          "anyOf": [
            { "type": "string", "maxLength": 4000 },
            { "type": "null" }
          ]
        },
        "painHypotheses": {
          "type": "array",
          "maxItems": 4,
          "items": { "$ref": "#/$defs/painHypothesis" }
        },
        "userSegments": {
          "type": "array",
          "maxItems": 8,
          "items": { "$ref": "#/$defs/userSegment" }
        },
        "currentWorkflows": {
          "type": "array",
          "maxItems": 6,
          "items": { "$ref": "#/$defs/currentWorkflow" }
        },
        "alternatives": {
          "type": "array",
          "maxItems": 8,
          "items": { "$ref": "#/$defs/alternative" }
        },
        "markets": {
          "type": "array",
          "maxItems": 4,
          "items": { "$ref": "#/$defs/productMarket" }
        },
        "contenderPlans": {
          "type": "array",
          "maxItems": 8,
          "items": { "$ref": "#/$defs/contenderPlan" }
        },
        "tournamentExperiments": {
          "type": "array",
          "maxItems": 8,
          "items": { "$ref": "#/$defs/productTournamentExperiment" }
        },
        "tournaments": {
          "type": "array",
          "maxItems": 4,
          "items": { "$ref": "#/$defs/productTournament" }
        },
        "tournamentContenders": {
          "type": "array",
          "maxItems": 12,
          "items": { "$ref": "#/$defs/productTournamentContender" }
        },
        "tournamentRounds": {
          "type": "array",
          "maxItems": 12,
          "items": { "$ref": "#/$defs/productTournamentRound" }
        },
        "scenarioCohorts": {
          "type": "array",
          "maxItems": 8,
          "items": { "$ref": "#/$defs/scenarioCohort" }
        },
        "decisions": {
          "type": "array",
          "maxItems": 8,
          "items": { "$ref": "#/$defs/tournamentDecision" }
        }
      }
    },
    "painHypothesis": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "rawPain",
        "targetSituation",
        "painFrequency",
        "painSeverity",
        "costOfInaction",
        "successSignals",
        "unknowns",
        "status",
        "createdAt",
        "updatedAt"
      ],
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "rawPain": { "type": "string" },
        "targetSituation": { "type": "string" },
        "painFrequency": { "type": "string" },
        "painSeverity": { "type": "string" },
        "costOfInaction": { "type": "string" },
        "successSignals": { "type": "array", "maxItems": 8, "items": { "type": "string" } },
        "unknowns": { "type": "array", "maxItems": 8, "items": { "type": "string" } },
        "status": {
          "type": "string",
          "enum": ["draft", "active", "reframed", "resolved", "parked"]
        },
        "createdAt": { "type": "number" },
        "updatedAt": { "type": "number" }
      }
    },
    "userSegment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "painID",
        "name",
        "role",
        "context",
        "goals",
        "constraints",
        "currentWorkflowIDs",
        "alternativeIDs",
        "decisionCriteria",
        "skepticism"
      ],
      "properties": {
        "id": { "type": "string" },
        "painID": { "type": "string" },
        "name": { "type": "string" },
        "role": { "type": "string" },
        "context": { "type": "string" },
        "goals": { "type": "array", "maxItems": 8, "items": { "type": "string" } },
        "constraints": { "type": "array", "maxItems": 8, "items": { "type": "string" } },
        "currentWorkflowIDs": {
          "type": "array",
          "maxItems": 8,
          "items": { "type": "string" }
        },
        "alternativeIDs": { "type": "array", "maxItems": 8, "items": { "type": "string" } },
        "decisionCriteria": { "type": "array", "maxItems": 8, "items": { "type": "string" } },
        "skepticism": { "type": "string" }
      }
    },
    "currentWorkflow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "painID",
        "title",
        "steps",
        "tools",
        "handoffs",
        "failureModes",
        "workarounds",
        "estimatedCost"
      ],
      "properties": {
        "id": { "type": "string" },
        "painID": { "type": "string" },
        "title": { "type": "string" },
        "steps": { "type": "array", "maxItems": 8, "items": { "type": "string" } },
        "tools": { "type": "array", "maxItems": 8, "items": { "type": "string" } },
        "handoffs": { "type": "array", "maxItems": 8, "items": { "type": "string" } },
        "failureModes": { "type": "array", "maxItems": 8, "items": { "type": "string" } },
        "workarounds": { "type": "array", "maxItems": 8, "items": { "type": "string" } },
        "estimatedCost": { "type": "string" }
      }
    },
    "alternative": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "painID", "title", "kind", "strengths", "weaknesses", "switchingCost"],
      "properties": {
        "id": { "type": "string" },
        "painID": { "type": "string" },
        "title": { "type": "string" },
        "kind": {
          "type": "string",
          "enum": [
            "manual",
            "spreadsheet",
            "existing_tool",
            "internal_workaround",
            "outsourced",
            "do_nothing"
          ]
        },
        "strengths": { "type": "array", "maxItems": 8, "items": { "type": "string" } },
        "weaknesses": { "type": "array", "maxItems": 8, "items": { "type": "string" } },
        "switchingCost": { "type": "string" }
      }
    },
    "productMarket": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "painID",
        "category",
        "summary",
        "marketForces",
        "actors",
        "buyingCommittees",
        "incumbents",
        "channels",
        "budgetModels",
        "adoptionTimelines",
        "marketProofDebt"
      ],
      "properties": {
        "id": { "type": "string" },
        "painID": { "type": "string" },
        "category": { "type": "string" },
        "summary": { "type": "string" },
        "marketForces": {
          "type": "array",
          "maxItems": 12,
          "items": { "$ref": "#/$defs/marketForce" }
        },
        "actors": {
          "type": "array",
          "maxItems": 12,
          "items": { "$ref": "#/$defs/marketActor" }
        },
        "buyingCommittees": {
          "type": "array",
          "maxItems": 6,
          "items": { "$ref": "#/$defs/buyingCommittee" }
        },
        "incumbents": {
          "type": "array",
          "maxItems": 8,
          "items": { "$ref": "#/$defs/incumbentPressure" }
        },
        "channels": {
          "type": "array",
          "maxItems": 10,
          "items": { "$ref": "#/$defs/acquisitionChannel" }
        },
        "budgetModels": {
          "type": "array",
          "maxItems": 6,
          "items": { "$ref": "#/$defs/budgetModel" }
        },
        "adoptionTimelines": {
          "type": "array",
          "maxItems": 4,
          "items": { "$ref": "#/$defs/adoptionTimeline" }
        },
        "marketProofDebt": { "$ref": "#/$defs/marketProofDebt" }
      }
    },
    "marketActor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "marketID",
        "segmentID",
        "role",
        "name",
        "jobToBeDone",
        "successCriteria",
        "objections",
        "informationSources",
        "trustThreshold"
      ],
      "properties": {
        "id": { "type": "string" },
        "marketID": { "type": "string" },
        "segmentID": { "anyOf": [{ "type": "string" }, { "type": "null" }] },
        "role": {
          "type": "string",
          "enum": [
            "operator",
            "economic_buyer",
            "manager_sponsor",
            "technical_gatekeeper",
            "procurement_gatekeeper",
            "security_reviewer",
            "incumbent_defender",
            "channel_visitor",
            "churned_user"
          ]
        },
        "name": { "type": "string" },
        "jobToBeDone": { "type": "string" },
        "successCriteria": { "type": "array", "maxItems": 8, "items": { "type": "string" } },
        "objections": { "type": "array", "maxItems": 8, "items": { "type": "string" } },
        "informationSources": { "type": "array", "maxItems": 8, "items": { "type": "string" } },
        "trustThreshold": { "type": "string" }
      }
    },
    "buyingCommittee": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "marketID",
        "name",
        "actorIDs",
        "decisionProcess",
        "approvalThreshold",
        "vetoRisks"
      ],
      "properties": {
        "id": { "type": "string" },
        "marketID": { "type": "string" },
        "name": { "type": "string" },
        "actorIDs": { "type": "array", "maxItems": 12, "items": { "type": "string" } },
        "decisionProcess": { "type": "string" },
        "approvalThreshold": { "type": "string" },
        "vetoRisks": { "type": "array", "maxItems": 8, "items": { "type": "string" } }
      }
    },
    "incumbentPressure": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "marketID",
        "alternativeID",
        "name",
        "category",
        "whyItWinsToday",
        "switchingMoat",
        "copyRisk",
        "failureOpening"
      ],
      "properties": {
        "id": { "type": "string" },
        "marketID": { "type": "string" },
        "alternativeID": { "anyOf": [{ "type": "string" }, { "type": "null" }] },
        "name": { "type": "string" },
        "category": { "type": "string" },
        "whyItWinsToday": { "type": "array", "maxItems": 8, "items": { "type": "string" } },
        "switchingMoat": { "type": "array", "maxItems": 8, "items": { "type": "string" } },
        "copyRisk": { "type": "string" },
        "failureOpening": { "type": "string" }
      }
    },
    "acquisitionChannel": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "marketID",
        "kind",
        "audience",
        "userIntent",
        "messageFit",
        "reachability",
        "costRisk",
        "proofRequired"
      ],
      "properties": {
        "id": { "type": "string" },
        "marketID": { "type": "string" },
        "kind": {
          "type": "string",
          "enum": [
            "founder_led_sales",
            "cold_outbound",
            "seo",
            "marketplace",
            "community",
            "open_source",
            "integration_partner",
            "paid_ads",
            "templates",
            "content",
            "existing_audience"
          ]
        },
        "audience": { "type": "string" },
        "userIntent": { "type": "string" },
        "messageFit": { "type": "string" },
        "reachability": { "type": "integer", "minimum": 0, "maximum": 5 },
        "costRisk": { "type": "integer", "minimum": 0, "maximum": 5 },
        "proofRequired": { "type": "array", "maxItems": 8, "items": { "type": "string" } }
      }
    },
    "budgetModel": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "marketID",
        "buyerActorID",
        "budgetSource",
        "priceToleranceCentsMonthly",
        "procurementThresholdCentsAnnual",
        "roiLogic",
        "objectionTriggers"
      ],
      "properties": {
        "id": { "type": "string" },
        "marketID": { "type": "string" },
        "buyerActorID": { "anyOf": [{ "type": "string" }, { "type": "null" }] },
        "budgetSource": { "type": "string" },
        "priceToleranceCentsMonthly": { "anyOf": [{ "type": "integer" }, { "type": "null" }] },
        "procurementThresholdCentsAnnual": { "anyOf": [{ "type": "integer" }, { "type": "null" }] },
        "roiLogic": { "type": "string" },
        "objectionTriggers": { "type": "array", "maxItems": 8, "items": { "type": "string" } }
      }
    },
    "adoptionTimeline": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "marketID", "name", "stages"],
      "properties": {
        "id": { "type": "string" },
        "marketID": { "type": "string" },
        "name": { "type": "string" },
        "stages": {
          "type": "array",
          "maxItems": 12,
          "items": { "$ref": "#/$defs/adoptionStage" }
        }
      }
    },
    "adoptionStage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "dayOffset", "trigger", "userQuestion", "passSignal", "failSignal"],
      "properties": {
        "id": { "type": "string" },
        "dayOffset": { "type": "integer" },
        "trigger": { "type": "string" },
        "userQuestion": { "type": "string" },
        "passSignal": { "type": "string" },
        "failSignal": { "type": "string" }
      }
    },
    "marketForce": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "marketID", "kind", "summary", "strength", "evidenceBasis"],
      "properties": {
        "id": { "type": "string" },
        "marketID": { "type": "string" },
        "kind": {
          "type": "string",
          "enum": [
            "urgency",
            "frequency",
            "pain_cost",
            "alternative_gravity",
            "budget_clarity",
            "channel_reachability",
            "trust_risk",
            "switching_cost",
            "competitive_moat"
          ]
        },
        "summary": { "type": "string" },
        "strength": { "type": "integer", "minimum": 0, "maximum": 5 },
        "evidenceBasis": { "type": "string" }
      }
    },
    "marketProofDebt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "attentionDeficit",
        "urgencyDeficit",
        "buyerClarityDeficit",
        "budgetFitDeficit",
        "incumbentDefeatDeficit",
        "channelFitDeficit",
        "retentionDeficit",
        "committeeDeficit"
      ],
      "properties": {
        "attentionDeficit": { "type": "integer", "minimum": 0 },
        "urgencyDeficit": { "type": "integer", "minimum": 0 },
        "buyerClarityDeficit": { "type": "integer", "minimum": 0 },
        "budgetFitDeficit": { "type": "integer", "minimum": 0 },
        "incumbentDefeatDeficit": { "type": "integer", "minimum": 0 },
        "channelFitDeficit": { "type": "integer", "minimum": 0 },
        "retentionDeficit": { "type": "integer", "minimum": 0 },
        "committeeDeficit": { "type": "integer", "minimum": 0 }
      }
    },
    "contenderPlan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "painID",
        "title",
        "promise",
        "contenderPlan",
        "targetSegmentIDs",
        "differentiator",
        "whyThisCouldWin",
        "whyThisMightFail",
        "requiredProof",
        "status"
      ],
      "properties": {
        "id": { "type": "string" },
        "painID": { "type": "string" },
        "title": { "type": "string" },
        "promise": { "type": "string" },
        "contenderPlan": { "type": "string" },
        "targetSegmentIDs": { "type": "array", "maxItems": 8, "items": { "type": "string" } },
        "differentiator": { "type": "string" },
        "whyThisCouldWin": { "type": "string" },
        "whyThisMightFail": { "type": "string" },
        "requiredProof": { "type": "array", "maxItems": 8, "items": { "type": "string" } },
        "status": {
          "type": "string",
          "enum": ["candidate", "active", "promoted", "rejected", "parked"]
        }
      }
    },
    "productTournamentExperiment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "contenderPlanID",
        "title",
        "branchName",
        "worktreeID",
        "baseSha",
        "currentSha",
        "implementationScope",
        "scenarioCohortIDs",
        "evidenceSummary",
        "decision",
        "createdAt",
        "updatedAt"
      ],
      "properties": {
        "id": { "type": "string" },
        "contenderPlanID": { "type": "string" },
        "title": { "type": "string" },
        "branchName": { "type": "string" },
        "worktreeID": { "type": "string" },
        "baseSha": { "anyOf": [{ "type": "string" }, { "type": "null" }] },
        "currentSha": { "anyOf": [{ "type": "string" }, { "type": "null" }] },
        "implementationScope": { "type": "string" },
        "scenarioCohortIDs": { "type": "array", "maxItems": 8, "items": { "type": "string" } },
        "evidenceSummary": { "type": "string" },
        "decision": {
          "type": "string",
          "enum": ["not_run", "continue", "narrow", "pivot", "kill", "promote", "archived", "promoted"]
        },
        "createdAt": { "type": "number" },
        "updatedAt": { "type": "number" }
      }
    },
    "productTournament": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "painID",
        "title",
        "premise",
        "contenderIDs",
        "roundIDs",
        "currentRoundID",
        "status",
        "createdAt",
        "updatedAt"
      ],
      "properties": {
        "id": { "type": "string" },
        "painID": { "type": "string" },
        "title": { "type": "string" },
        "premise": { "type": "string" },
        "contenderIDs": { "type": "array", "maxItems": 8, "items": { "type": "string" } },
        "roundIDs": { "type": "array", "maxItems": 8, "items": { "type": "string" } },
        "currentRoundID": { "anyOf": [{ "type": "string" }, { "type": "null" }] },
        "status": {
          "type": "string",
          "enum": ["drafting", "active", "completed", "archived"]
        },
        "createdAt": { "type": "number" },
        "updatedAt": { "type": "number" }
      }
    },
    "productTournamentContender": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "tournamentID",
        "contenderPlanID",
        "experimentID",
        "title",
        "productPlan",
        "valueProposition",
        "primaryRisk",
        "targetSegmentIDs",
        "status",
        "createdAt",
        "updatedAt"
      ],
      "properties": {
        "id": { "type": "string" },
        "tournamentID": { "type": "string" },
        "contenderPlanID": { "type": "string" },
        "experimentID": { "anyOf": [{ "type": "string" }, { "type": "null" }] },
        "title": { "type": "string" },
        "productPlan": { "type": "string" },
        "valueProposition": { "type": "string" },
        "primaryRisk": { "type": "string" },
        "targetSegmentIDs": { "type": "array", "maxItems": 8, "items": { "type": "string" } },
        "status": {
          "type": "string",
          "enum": ["competing", "narrowed", "needs_revision", "eliminated", "winner", "archived"]
        },
        "createdAt": { "type": "number" },
        "updatedAt": { "type": "number" }
      }
    },
    "productTournamentRound": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "tournamentID",
        "ordinal",
        "kind",
        "title",
        "goal",
        "evaluationFocus",
        "contenderIDs",
        "scenarioCohortIDs",
        "status",
        "createdAt",
        "updatedAt"
      ],
      "properties": {
        "id": { "type": "string" },
        "tournamentID": { "type": "string" },
        "ordinal": { "type": "integer" },
        "kind": {
          "type": "string",
          "enum": ["market_compilation", "product_plans", "core_technology", "product_implementation"]
        },
        "title": { "type": "string" },
        "goal": { "type": "string" },
        "evaluationFocus": { "type": "array", "maxItems": 8, "items": { "type": "string" } },
        "contenderIDs": { "type": "array", "maxItems": 8, "items": { "type": "string" } },
        "scenarioCohortIDs": {
          "type": "array",
          "maxItems": 8,
          "items": { "type": "string" }
        },
        "status": {
          "type": "string",
          "enum": ["planned", "active", "completed", "skipped"]
        },
        "createdAt": { "type": "number" },
        "updatedAt": { "type": "number" }
      }
    },
    "scenarioCohort": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "experimentID", "scenarioIDs", "enabled", "tags"],
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "experimentID": { "type": "string" },
        "scenarioIDs": { "type": "array", "maxItems": 12, "items": { "type": "string" } },
        "enabled": { "type": "boolean" },
        "tags": { "type": "array", "maxItems": 8, "items": { "type": "string" } }
      }
    },
    "tournamentDecision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "experimentID", "decision", "summary", "evidenceRunIDs", "decidedAt", "decidedBy"],
      "properties": {
        "id": { "type": "string" },
        "experimentID": { "type": "string" },
        "decision": {
          "type": "string",
          "enum": ["not_run", "continue", "narrow", "pivot", "kill", "promote", "archived", "promoted"]
        },
