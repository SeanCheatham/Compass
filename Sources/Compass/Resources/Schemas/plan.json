{
  "type": "object",
  "additionalProperties": false,
  "required": ["state", "lessonEdits"],
  "properties": {
    "state": {
      "type": "object",
      "additionalProperties": false,
      "required": ["immediate", "candidates", "strategicContext", "openQuestions"],
      "properties": {
        "immediate": { "$ref": "#/$defs/immediate" },
        "candidates": {
          "type": "array",
          "maxItems": 6,
          "items": { "$ref": "#/$defs/candidate" }
        },
        "strategicContext": { "$ref": "#/$defs/strategicContext" },
        "openQuestions": {
          "type": "array",
          "maxItems": 4,
          "items": { "$ref": "#/$defs/openQuestion" }
        }
      }
    },
    "lessonEdits": {
      "type": "array",
      "items": { "$ref": "#/$defs/lessonEdit" }
    },
    "pmfProofAction": {
      "anyOf": [
        { "$ref": "#/$defs/pmfProofAction" },
        { "type": "null" }
      ],
      "description": "Optional PMF proof-action metadata for the selected Immediate handoff."
    }
  },
  "$defs": {
    "pmfProofAction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "targetUnknown", "expectedProof", "minimumContext", "legacyReferences"],
      "properties": {
        "kind": { "$ref": "#/$defs/pmfProofActionKind" },
        "targetUnknown": {
          "type": "string",
          "description": "Short label for the PMF unknown this action reduces."
        },
        "expectedProof": {
          "type": "string",
          "description": "Observable proof signal expected from the next action."
        },
        "minimumContext": {
          "type": "array",
          "maxItems": 8,
          "items": { "$ref": "#/$defs/pmfContextNeed" }
        },
        "legacyReferences": {
          "type": "array",
          "maxItems": 10,
          "items": { "$ref": "#/$defs/pmfProofSourceReference" }
        }
      }
    },
    "pmfProofActionKind": {
      "type": "string",
      "enum": [
        "sharpen_hypothesis",
        "run_plan_proof",
        "run_buyer_proof",
        "build_feasibility_slice",
        "run_switching_proof",
        "run_use_proof",
        "revise_product",
        "stop_no_useful_proof"
      ]
    },
    "pmfContextNeed": {
      "type": "string",
      "enum": [
        "hypothesis",
        "top_unknowns",
        "recent_evidence",
        "legacy_ids",
        "repo_slice",
        "proof_instructions"
      ]
    },
    "pmfProofSourceReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "value"],
      "properties": {
        "kind": { "$ref": "#/$defs/pmfProofSourceKind" },
        "value": { "type": "string" }
      }
    },
    "pmfProofSourceKind": {
      "type": "string",
      "enum": [
        "tournamentID",
        "contenderID",
        "contenderPlanID",
        "experimentID",
        "roundID",
        "planEvaluationID",
        "evidenceRunID",
        "decisionID",
        "painID",
        "segmentID",
        "workflowID",
        "alternativeID"
      ]
    },
    "immediate": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "plan",
            "verify",
            "verifyTimeoutMs",
            "estimatedDifficulty",
            "selectedBecause",
            "source",
            "candidateID"
          ],
          "properties": {
            "plan": {
              "type": "string",
              "description": "Compact Markdown handoff with Outcome, Why it matters, and Acceptance checks. Acceptance checks must describe observable behavior or UI/state outcomes, not shell commands."
            },
            "verify": {
              "type": "string",
              "description": "Shell command Compass should run from the repository root. Put commands here, not in Acceptance checks."
            },
            "verifyTimeoutMs": {
              "anyOf": [
                { "type": "integer", "minimum": 1 },
                { "type": "null" }
              ]
            },
            "estimatedDifficulty": {
              "anyOf": [
                { "type": "string", "enum": ["low", "medium", "high"] },
                { "type": "null" }
              ]
            },
            "selectedBecause": {
              "type": "string",
              "description": "One sentence explaining why this slice was selected now."
            },
            "source": {
              "type": "string",
              "enum": ["draft", "feedback", "candidate", "focus", "repository", "repair"]
            },
            "candidateID": {
              "anyOf": [
                { "type": "string" },
                { "type": "null" }
              ]
            }
          }
        },
        { "type": "null" }
      ]
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "outcome",
        "why",
        "category",
        "origin",
        "priority",
        "status",
        "evidence",
        "blockedBy",
        "risk"
      ],
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "outcome": { "type": "string" },
        "why": { "type": "string" },
        "category": {
          "type": "string",
          "enum": ["feature", "test", "cleanup", "docs", "bugHunt", "reliability", "exploration"]
        },
        "origin": {
          "type": "string",
          "enum": ["draft", "feedback", "repository", "plan", "reflect", "lesson", "user"]
        },
        "priority": { "type": "string", "enum": ["low", "medium", "high"] },
        "status": {
          "type": "string",
          "enum": ["available", "active", "blocked", "deferred", "done", "stale"]
        },
        "evidence": { "type": "array", "items": { "type": "string" }, "maxItems": 3 },
        "blockedBy": { "type": "array", "items": { "type": "string" }, "maxItems": 2 },
        "risk": {
          "anyOf": [
            { "type": "string" },
            { "type": "null" }
          ]
        }
      }
    },
    "strategicContext": {
      "type": "object",
      "additionalProperties": false,
      "required": ["thesis", "principles", "constraints", "nonGoals", "risks"],
      "properties": {
        "thesis": { "type": "string" },
        "principles": { "type": "array", "items": { "type": "string" }, "maxItems": 5 },
        "constraints": { "type": "array", "items": { "type": "string" }, "maxItems": 5 },
        "nonGoals": { "type": "array", "items": { "type": "string" }, "maxItems": 5 },
        "risks": { "type": "array", "items": { "type": "string" }, "maxItems": 5 }
      }
    },
    "openQuestion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "question", "impact"],
      "properties": {
        "id": { "type": "string" },
        "question": { "type": "string" },
        "impact": { "type": "string" }
      }
    },
    "lessonEdit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["find", "replace", "replaceAll"],
      "properties": {
        "find": { "type": "string" },
        "replace": { "type": "string" },
        "replaceAll": {
          "anyOf": [
            { "type": "boolean" },
            { "type": "null" }
          ]
        }
      }
    }
  }
}
