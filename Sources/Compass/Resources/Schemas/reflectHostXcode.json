{
  "type": "object",
  "additionalProperties": false,
  "required": ["state", "summary", "lessonEdits"],
  "properties": {
    "state": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["immediate", "candidates", "strategicContext", "openQuestions"],
          "properties": {
            "immediate": { "$ref": "#/$defs/immediate" },
            "candidates": {
              "type": "array",
              "maxItems": 6,
              "items": { "$ref": "#/$defs/candidate" }
            },
            "strategicContext": { "$ref": "#/$defs/strategicContext" },
            "openQuestions": {
              "type": "array",
              "maxItems": 4,
              "items": { "$ref": "#/$defs/openQuestion" }
            }
          }
        },
        { "type": "null" }
      ]
    },
    "summary": { "type": "string" },
    "lessonEdits": {
      "type": "array",
      "items": { "$ref": "#/$defs/lessonEdit" }
    }
  },
  "$defs": {
    "immediate": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "plan",
            "verify",
            "verifyTimeoutMs",
            "estimatedDifficulty",
            "selectedBecause",
            "source",
            "candidateID",
            "requiresHostXcode"
          ],
          "properties": {
            "plan": { "type": "string" },
            "verify": { "type": "string" },
            "verifyTimeoutMs": {
              "anyOf": [
                { "type": "integer", "minimum": 1 },
                { "type": "null" }
              ]
            },
            "estimatedDifficulty": {
              "anyOf": [
                { "type": "string", "enum": ["low", "medium", "high"] },
                { "type": "null" }
              ]
            },
            "selectedBecause": { "type": "string" },
            "source": {
              "type": "string",
              "enum": ["draft", "feedback", "candidate", "focus", "repository", "repair"]
            },
            "candidateID": {
              "anyOf": [
                { "type": "string" },
                { "type": "null" }
              ]
            },
            "requiresHostXcode": { "type": "boolean" }
          }
        },
        { "type": "null" }
      ]
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "outcome",
        "why",
        "category",
        "origin",
        "priority",
        "status",
        "evidence",
        "blockedBy",
        "risk"
      ],
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "outcome": { "type": "string" },
        "why": { "type": "string" },
        "category": {
          "type": "string",
          "enum": ["feature", "test", "cleanup", "docs", "bugHunt", "reliability", "exploration"]
        },
        "origin": {
          "type": "string",
          "enum": ["draft", "feedback", "repository", "plan", "reflect", "lesson", "user"]
        },
        "priority": { "type": "string", "enum": ["low", "medium", "high"] },
        "status": {
          "type": "string",
          "enum": ["available", "active", "blocked", "deferred", "done", "stale"]
        },
        "evidence": { "type": "array", "items": { "type": "string" }, "maxItems": 3 },
        "blockedBy": { "type": "array", "items": { "type": "string" }, "maxItems": 2 },
        "risk": {
          "anyOf": [
            { "type": "string" },
            { "type": "null" }
          ]
        }
      }
    },
    "strategicContext": {
      "type": "object",
      "additionalProperties": false,
      "required": ["thesis", "principles", "constraints", "nonGoals", "risks"],
      "properties": {
        "thesis": { "type": "string" },
        "principles": { "type": "array", "items": { "type": "string" }, "maxItems": 5 },
        "constraints": { "type": "array", "items": { "type": "string" }, "maxItems": 5 },
        "nonGoals": { "type": "array", "items": { "type": "string" }, "maxItems": 5 },
        "risks": { "type": "array", "items": { "type": "string" }, "maxItems": 5 }
      }
    },
    "openQuestion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "question", "impact"],
      "properties": {
        "id": { "type": "string" },
        "question": { "type": "string" },
        "impact": { "type": "string" }
      }
    },
    "lessonEdit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["find", "replace", "replaceAll"],
      "properties": {
        "find": { "type": "string" },
        "replace": { "type": "string" },
        "replaceAll": {
          "anyOf": [
            { "type": "boolean" },
            { "type": "null" }
          ]
        }
      }
    }
  }
}
