; Tree-sitter grammar packages declare incompatible (peerOptional) ranges
; against the tree-sitter core (e.g. tree-sitter-typescript pins ^0.21,
; tree-sitter-rust pins ^0.22.1, tree-sitter-go pins ^0.25). The native
; C ABI is stable across these versions so the runtime is fine; only
; npm's resolver objects. Enable legacy peer-dep behaviour project-wide
; so `npm install` works without `--legacy-peer-deps`.
legacy-peer-deps=true
