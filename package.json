{
  "name": "compass-cli",
  "version": "0.1.0",
  "description": "Recursive iteration tool for project development that wraps Claude Code CLI",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "compass": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node dist/index.js",
    "lint": "eslint src/",
    "clean": "rm -rf dist/"
