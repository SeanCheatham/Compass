{
  "name": "compass",
  "version": "0.1.0",
  "description": "Recursive iteration tool for autonomous project development using Claude Agent SDK or Codex SDK",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "compass": "dist/index.js"
  },
  "scripts": {
    "build": "npm run build:frontend && tsc",
    "build:frontend": "node scripts/build-frontend.js",
    "dev": "tsc --watch",
    "start": "node dist/index.js",
    "lint": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts"
  },
  "keywords": [
    "claude",
    "codex",
    "ai",
    "agent",
    "autonomous",
    "development"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.2.139",
    "@openai/codex-sdk": "^0.130.0",
    "commander": "^14.0.3",
    "tree-sitter": "^0.25.0",
    "tree-sitter-go": "^0.25.0",
    "tree-sitter-javascript": "^0.25.0",
    "tree-sitter-python": "^0.25.0",
    "tree-sitter-rust": "^0.24.0",
    "tree-sitter-typescript": "^0.23.2",
    "ws": "^8.20.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^25.6.2",
    "@types/ws": "^8.18.1",
    "esbuild": "^0.28.0",
    "tsx": "^4.19.0",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
